{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env*.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env*.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(type .env)"
    ]
  }
}
