# Copy to .env and fill in real values. .env is gitignored.

# Backend base URL. Android emulator reaches the host machine's localhost via
# 10.0.2.2, not localhost/127.0.0.1. Use your LAN IP for a physical device,
# or the deployed dev/staging URL once it exists.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8081

# Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
KAKAO_NATIVE_APP_KEY=

# Google Cloud Console > OAuth 2.0 Client IDs > Web client
# Passed at runtime to GoogleSignin.configure() (app/login.tsx) — no native
# config needed on Android, so this is the only Google-related value needed here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
